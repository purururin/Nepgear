    BOOL LoadCustomFont(HMODULE hModule) {
        if (!Config::FontFileName[0]) return FALSE;

        WCHAR rootDir[MAX_PATH] = {};
        if (!GetModuleFileNameW(hModule, rootDir, MAX_PATH)) return FALSE;
        PathRemoveFileSpecW(rootDir);

        WCHAR fontPath[MAX_PATH] = {};
        if (Utils::ResolvePatchFilePathW(
            Config::FontFileName, fontPath, _countof(fontPath))) {
            // Packaged fonts use a flat file in the system temp directory.
        } else if (Config::EnableFileHook) {
            swprintf_s(fontPath, MAX_PATH, L"%s\\%s\\%s",
                rootDir, Config::RedirectFolderW, Config::FontFileName);
            if (!PathFileExistsW(fontPath)) fontPath[0] = 0;
        }
        if (!fontPath[0]) {
            swprintf_s(fontPath, MAX_PATH, L"%s\\%s", rootDir, Config::FontFileName);
        }
        if (!PathFileExistsW(fontPath)) {
            LogW(LOG_WARN, L"[Font] Font file not found: %s", fontPath);
            return FALSE;
        }

        int resourceCount = AddFontResourceExW(fontPath, FR_PRIVATE, NULL);
        if (resourceCount > 0) {
            LogW(L"[Font] Loaded private font resource: %s (count=%d)", fontPath, resourceCount);
            if (!Config::EnableCodepageSpoof && !Config::EnableFontVerticalMetrics) return TRUE;
        } else {
            LogW(LOG_WARN, L"[Font] AddFontResourceExW failed: %s (error=%lu)",
                fontPath, GetLastError());
        }

        HANDLE file = CreateFileW(fontPath, GENERIC_READ, FILE_SHARE_READ, NULL,
            OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
        if (file == INVALID_HANDLE_VALUE) return resourceCount > 0;

        LARGE_INTEGER fileSize = {};
        if (!GetFileSizeEx(file, &fileSize) || fileSize.QuadPart <= 0 ||
            fileSize.QuadPart > MAXDWORD) {
            CloseHandle(file);
            return resourceCount > 0;
        }

        std::vector<BYTE> fontData((size_t)fileSize.QuadPart);
        DWORD bytesRead = 0;
        BOOL readOk = ReadFile(file, fontData.data(), (DWORD)fontData.size(), &bytesRead, NULL);
        CloseHandle(file);
        if (!readOk || bytesRead != fontData.size()) return resourceCount > 0;

        if (FontPatcher::IsFontCollection(fontData.data(), fontData.size())) {
            std::vector<BYTE> extracted;
            const wchar_t* faceName = Config::ForcedFontNameW[0]
                ? Config::ForcedFontNameW : NULL;
            if (!FontPatcher::ExtractFontFromCollectionByName(fontData, faceName, extracted)) {
                LogW(LOG_WARN, L"[Font] TTC face extraction failed: %s", fontPath);
                return resourceCount > 0;
            }
            fontData.swap(extracted);
        }

        if (Config::EnableCodepageSpoof &&
            FontPatcher::PatchOS2CodePageRangeForCharset(fontData, Config::SpoofToCharset)) {
            Log("[Font] Patched OS/2 codepage range for charset %lu.", Config::SpoofToCharset);
        }

        if (Config::EnableFontVerticalMetrics) {
            int lineGap = Config::EnableFontLineSpacing ? Config::FontLineSpacing : 0;
            if (FontPatcher::PatchVerticalMetrics(fontData,
                Config::FontAscentPermille, Config::FontDescentPermille, lineGap)) {
                Log("[Font] Patched vertical metrics: ascent=%d descent=%d gap=%d.",
                    Config::FontAscentPermille, Config::FontDescentPermille, lineGap);
            }
        }

        DWORD memoryFontCount = 0;
        HANDLE memoryFont = AddFontMemResourceEx(
            fontData.data(), (DWORD)fontData.size(), NULL, &memoryFontCount);
        if (memoryFont) {
            LogW(L"[Font] Loaded patched memory font: %s (count=%lu)",
                fontPath, memoryFontCount);
            return TRUE;
        }

        LogW(LOG_WARN, L"[Font] AddFontMemResourceEx failed: %s (error=%lu)",
            fontPath, GetLastError());
        return resourceCount > 0;
    }
