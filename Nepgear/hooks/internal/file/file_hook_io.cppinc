BOOL WINAPI newSetEndOfFile(HANDLE hFile) {
    __try {
        if (IsVirtualHandleRange(hFile) && VFS::IsVirtualHandle(hFile)) {
            return VFS::SetVirtualFileEnd(hFile);
        }
    }
    __except(EXCEPTION_EXECUTE_HANDLER) {
        Utils::Log("[VFS] Exception in newSetEndOfFile for handle %p", hFile);
    }
    return orgSetEndOfFile(hFile);
}

BOOL WINAPI newWriteFile(HANDLE hFile, LPCVOID lpBuffer, DWORD nNumberOfBytesToWrite,
    LPDWORD lpNumberOfBytesWritten, LPOVERLAPPED lpOverlapped) {
    __try {
        if (IsVirtualHandleRange(hFile) && VFS::IsVirtualHandle(hFile)) {
            if (lpNumberOfBytesWritten) *lpNumberOfBytesWritten = 0;
            SetLastError(ERROR_ACCESS_DENIED);
            return FALSE;
        }
    }
    __except(EXCEPTION_EXECUTE_HANDLER) {
        Utils::Log("[VFS] Exception in newWriteFile for handle %p", hFile);
    }
    return orgWriteFile(hFile, lpBuffer, nNumberOfBytesToWrite,
        lpNumberOfBytesWritten, lpOverlapped);
}

