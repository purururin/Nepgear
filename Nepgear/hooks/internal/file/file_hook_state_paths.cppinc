static pCreateFileW orgKrkrDynamicCreateFileW = nullptr;
static pGetFileAttributesW orgKrkrDynamicGetFileAttributesW = nullptr;
static pFindFirstFileW orgKrkrDynamicFindFirstFileW = nullptr;
static pFindNextFileW orgKrkrDynamicFindNextFileW = nullptr;

static char g_GameRootA[MAX_PATH] = { 0 };
static wchar_t g_GameRootW[MAX_PATH] = { 0 };
static size_t g_GameRootLenA = 0;
static size_t g_GameRootLenW = 0;
static bool g_Initialized = false;

void InitPaths() {
    if (g_Initialized) return;
    if (GetModuleFileNameA(NULL, g_GameRootA, MAX_PATH)) {
        PathRemoveFileSpecA(g_GameRootA);
        PathAddBackslashA(g_GameRootA);
        g_GameRootLenA = strlen(g_GameRootA);
    }
    if (GetModuleFileNameW(NULL, g_GameRootW, MAX_PATH)) {
        PathRemoveFileSpecW(g_GameRootW);
        PathAddBackslashW(g_GameRootW);
        g_GameRootLenW = wcslen(g_GameRootW);
    }
    Utils::LogW(L"[Path] GameRootW: %s", g_GameRootW);
    Utils::Log("[Path] GameRootA: %s", g_GameRootA);
    g_Initialized = true;
}

bool GetRelativePathW(LPCWSTR inPath, wchar_t* outRelPath) {
    if (!inPath || !outRelPath || g_GameRootLenW == 0) return false;
    wchar_t fullAbsPath[MAX_PATH];
    if (GetFullPathNameW(inPath, MAX_PATH, fullAbsPath, NULL) == 0) return false;
    if (_wcsnicmp(fullAbsPath, g_GameRootW, g_GameRootLenW) == 0) {
        wcscpy_s(outRelPath, MAX_PATH, fullAbsPath + g_GameRootLenW);
        return true;
    }
    return false;
}

bool GetRelativePathA(LPCSTR inPath, char* outRelPath) {
    if (!inPath || !outRelPath) return false;

    const UINT candidates[] = {
        Config::EnableLE ? Config::LE_Codepage : CP_ACP,
        CP_ACP, Config::LE_Codepage, CP_UTF8
    };
    UINT previous = static_cast<UINT>(-1);
    for (UINT codepage : candidates) {
        if (codepage == previous) continue;
        previous = codepage;

        wchar_t widePath[MAX_PATH] = {};
        const DWORD flags = codepage == CP_UTF8 ? MB_ERR_INVALID_CHARS : 0;
        if (!MultiByteToWideChar(codepage, flags, inPath, -1, widePath, MAX_PATH)) continue;

        wchar_t relativePath[MAX_PATH] = {};
        if (!GetRelativePathW(widePath, relativePath)) continue;
        if (WideCharToMultiByte(Config::LE_Codepage, 0, relativePath, -1,
            outRelPath, MAX_PATH, nullptr, nullptr)) {
            return true;
        }
    }
    return false;
}

static inline bool IsVirtualHandleRange(HANDLE h) {
    uintptr_t v = (uintptr_t)h;
    return v >= 0x4F000000 && v < 0x50000000;
}
